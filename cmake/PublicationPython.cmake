# The viewer, the publication runner and GLAD must agree on which Python to use.
function(prepare_publication_python result)
    set(requirements "${CMAKE_CURRENT_SOURCE_DIR}/requirements.txt")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${requirements}")
    string(SHA256 identity "${Python3_EXECUTABLE}|${Python3_VERSION}|${CMAKE_CURRENT_BINARY_DIR}")
    string(SUBSTRING "${identity}" 0 12 identity)
    set(env_dir "${CMAKE_CURRENT_BINARY_DIR}/publication-env/${identity}")
    if(CMAKE_HOST_WIN32)
        set(interpreter "${env_dir}/Scripts/python.exe")
    else()
        set(interpreter "${env_dir}/bin/python")
    endif()
    file(LOCK "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/publication-python.lock" GUARD FUNCTION TIMEOUT 300)
    if(NOT EXISTS "${interpreter}" OR NOT EXISTS "${env_dir}/pyvenv.cfg")
        message(STATUS "Creating publication environment with ${Python3_EXECUTABLE}")
        execute_process(COMMAND "${Python3_EXECUTABLE}" -I -m venv "${env_dir}" COMMAND_ERROR_IS_FATAL ANY)
    endif()

    set(check "import glcontext, jinja2, moderngl, numpy, PIL.Image")
    set(marker "${env_dir}/requirements.sha256")
    file(SHA256 "${requirements}" expected)
    set(installed "")
    set(verified 1)
    if(EXISTS "${marker}")
        file(READ "${marker}" installed)
        if(installed STREQUAL expected)
            execute_process(COMMAND "${interpreter}" -I -c "${check}" RESULT_VARIABLE verified ERROR_QUIET)
        endif()
    endif()
    if(NOT verified STREQUAL "0")
        message(STATUS "Installing publication dependencies in ${env_dir}")
        set(reinstall "")
        if(installed STREQUAL expected)
            # The marker survived but an import failed, e.g. after a partial removal.
            set(reinstall --force-reinstall)
        endif()
        execute_process(COMMAND "${interpreter}" -I -m pip --disable-pip-version-check --no-input install ${reinstall} -r "${requirements}"
                        COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${interpreter}" -I -c "${check}" COMMAND_ERROR_IS_FATAL ANY)
        file(WRITE "${marker}" "${expected}")
    endif()
    # A deleted environment should also be repaired by a normal incremental build.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${interpreter}" "${marker}")
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/publication-python.txt" CONTENT "${interpreter}\n")
    set(${result} "${interpreter}" PARENT_SCOPE)
endfunction()
